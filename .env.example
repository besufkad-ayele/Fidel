# Fidel — environment template. Committed. Contains no real values.
# Copy to .env.local and fill in.

# ---- Supabase ----
# Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS. Must NEVER be prefixed NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_ID=<project-ref>
SUPABASE_DB_PASSWORD=

# ---- App ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# External request-access form URL (Typeform, Google Form, etc.)
NEXT_PUBLIC_REQUEST_ACCESS_URL=

# ---- Google Calendar / Meet ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/oauth/callback

# ---- Transactional email ----
RESEND_API_KEY=
EMAIL_FROM="Fidel <hello@fidel.app>"

# ---- Cron authentication ----
CRON_SECRET=
